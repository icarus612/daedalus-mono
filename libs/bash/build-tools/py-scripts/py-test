#!/bin/bash
set -e

if ! command -v uv &> /dev/null; then
  echo "uv not found on PATH. Install: https://docs.astral.sh/uv/getting-started/installation/" >&2
  exit 1
fi

if [ -d "tests" ]; then
  echo "Running pytest..."
  # --group dev is load-bearing: a bare `uv run pytest` does NOT install the
  # package's [dependency-groups] dev, so pytest resolves to whatever ambient
  # interpreter has one — on the wrong interpreter, without the package
  # importable. That is why maze-runner's suite failed with ModuleNotFoundError.
  uv run --group dev pytest
else
  echo "No tests/ directory - nothing to run."
  exit 0
fi
